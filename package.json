{
  "name": "web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "prebuild": "rimraf dist",
    "start:eleventy": "npm-run-all2 get-theme build:sass --parallel watch:eleventy:*",
    "watch:eleventy:sass": "sass --watch src/site/styles:dist/styles",
    "watch:eleventy:dev": "cross-env DOTENV_CONFIG_QUIET=true ELEVENTY_ENV=dev eleventy --serve",
    "build:eleventy": "npm-run-all2 get-theme build:eleventy:*",
    "build:eleventy:prod": "cross-env DOTENV_CONFIG_QUIET=true ELEVENTY_ENV=prod NODE_OPTIONS=--max-old-space-size=4096 eleventy",
    "build:eleventy:sass": "sass src/site/styles:dist/styles --style compressed",
    "get-theme": "cross-env DOTENV_CONFIG_QUIET=true node src/site/get-theme.js",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test \"test/*.test.*\"",
    "test:browser": "node --env-file-if-exists=.env.browser.local node_modules/vitest/vitest.mjs run --config vitest.browser.config.mts",
    "browser": "node --env-file-if-exists=.env.browser.local node_modules/agent-browser/bin/agent-browser.js",
    "test:posts": "node --test --test-isolation=none test/posts.test.ts",
    "test:permalinks": "node --test --test-isolation=none test/permalinks.test.ts",
    "test:callouts": "node --test --test-isolation=none test/callout.test.ts",
    "test:highlighting": "node --test --test-isolation=none test/highlighting.test.ts",
    "test:heading-links": "node --test --test-isolation=none test/heading-links.test.ts",
    "test:link-classes": "node --test --test-isolation=none test/link-classes.test.ts",
    "test:math": "node --test --test-isolation=none test/math.test.ts",
    "test:smart-punctuation": "node --test --test-isolation=none test/smart-punctuation.test.ts",
    "test:copy-code": "npm run test:browser -- copyCode",
    "test:callouts-browser": "npm run test:browser -- callouts",
    "test:images": "node --test --test-isolation=none test/digital-garden-images.test.ts",
    "test:images-plugin": "node --test --test-isolation=none test/images-plugin.test.ts",
    "test:images-build": "node --test --test-isolation=none test/images-build.test.ts",
    "test:wikilink-index": "node --test --test-isolation=none test/wikilink-index.test.ts",
    "generate:wikilink-index": "node scripts/generate-wikilink-index.ts",
    "predev:astro": "npm run generate:wikilink-index",
    "dev:astro": "astro dev",
    "prebuild:astro": "npm run generate:wikilink-index",
    "build:astro": "astro build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@vitest/browser-playwright": "^5.0.1",
    "agent-browser": "^0.38.1",
    "cross-env": "^10.1.0",
    "html-minifier-terser": "^7.2.0",
    "node-html-parser": "^7.1.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.99.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^4.0.2",
    "@astrojs/markdown-satteri": "^0.3.8",
    "@shikijs/markdown-it": "^4.1.0",
    "@shikijs/transformers": "^4.1.0",
    "@sindresorhus/slugify": "^1.1.0",
    "astro": "7.2.9",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "eleventy-plugin-gen-favicons": "^1.1.2",
    "eleventy-plugin-nesting-toc": "^1.3.0",
    "fs-file-tree": "^1.1.1",
    "github-slugger": "^2.0.0",
    "glob": "^10.2.1",
    "gray-matter": "^4.0.3",
    "jsep": "^1.4.0",
    "juice": "12.2.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.0.1",
    "markdown-it-attrs": "^4.5.0",
    "markdown-it-footnote": "^3.0.3",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-mathjax3": "^4.3.1",
    "markdown-it-plantuml": "^1.4.1",
    "markdown-it-task-checkbox": "^1.0.6",
    "mathjax-full": "3.2.1",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^4.4.1",
    "shiki": "^4.1.0",
    "yaml": "^2.8.3"
  }
}
