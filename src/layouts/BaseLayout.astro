---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { site } from "../lib/site";
import { canonicalUrl } from "../lib/metadata";
import SiteHead from "../components/SiteHead.astro";

// The document shell every page shares: head metadata, the stylesheet,
// Vercel Web Analytics and Speed Insights, and the page-wide client scripts.
// The analytics scripts load from `/_vercel/...` on this origin, which
// Vercel serves when the features are enabled for the project.
interface Props {
  title: string;
  /** Already filtered through `metaDescription`; omitted when undefined. */
  description?: string | undefined;
  /** Open Graph type: posts are articles, Home is the website itself. */
  type: "website" | "article";
}

const { title, description, type } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <SiteHead title={title}>
      {description && <meta name="description" content={description} />}
      <link rel="canonical" href={canonical} />
      <meta property="og:type" content={type} />
      <meta property="og:title" content={title} />
      {description && <meta property="og:description" content={description} />}
      <meta property="og:url" content={canonical} />
      <meta property="og:site_name" content={site.name} />
      <meta property="og:locale" content={site.lang} />
      <meta name="twitter:card" content="summary" />
    </SiteHead>
  </head>
  <body class="markdown-rendered">
    <slot name="navigation" />
    <main class="content">
      <slot />
    </main>
    <script>
      import { initializeCopyButtons } from "../scripts/copyCode";
      import { initializeCalloutToggles } from "../scripts/callouts";
      import { initializeFolderState } from "../scripts/folderState";
      import { initializeMobileNavigation } from "../scripts/mobileNavigation";
      import { initializeScrollRegions } from "../scripts/scrollRegions";
      import { initializeSearch } from "../scripts/search";
      import { initializeSearchDialog } from "../scripts/searchDialog";
      import { initializeSearchPreview } from "../scripts/searchPreview";

      initializeCopyButtons();
      initializeCalloutToggles();
      initializeScrollRegions();
      initializeMobileNavigation();
      initializeFolderState();
      initializeSearch();
      initializeSearchPreview();
      // Last: a `?q=` link opens the dialog and searches at once.
      initializeSearchDialog();
    </script>
    <!-- Custom elements, so they belong in the body, not the head. -->
    <Analytics />
    <SpeedInsights />
  </body>
</html>
