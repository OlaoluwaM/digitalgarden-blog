---
// Dev-only style guide (ADR 0003 phase 2), served at /style-guide/ by
// `npm run dev:astro` and never built. It lists every token straight from
// tokens.css, so it cannot drift from the file, then shows the chrome
// components and a Markdown sample with every element the notes can use.
import postcss from "postcss";
import tokensSource from "../styles/tokens.css?raw";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import NoteHeader from "../components/NoteHeader.astro";
import RecentPosts from "../components/RecentPosts.astro";
import PostFooter from "../components/PostFooter.astro";
import type { Post } from "../content/posts.ts";
import { Content as Sample } from "./sample.md";

const tokens: { name: string; value: string }[] = [];
postcss.parse(tokensSource).walkDecls(decl => {
  if (!decl.prop.endsWith("*")) {
    tokens.push({ name: decl.prop, value: decl.value.replace(/\s+/g, " ") });
  }
});
const group = (prefix: string) =>
  tokens.filter(
    token => token.name.startsWith(prefix) && !token.name.includes("--", 2)
  );
const colors = group("--color-");
const fonts = group("--font-").filter(token => !token.name.includes("weight"));
const sizes = group("--text-");
const leading = group("--leading-");
const radii = group("--radius-");
const other = tokens.filter(
  token =>
    !["--color-", "--font-", "--text-", "--leading-", "--radius-"].some(
      prefix => token.name.startsWith(prefix)
    ) || token.name.startsWith("--font-weight")
);
// xl and up are the heading sizes, set in the serif.
const heading = (name: string) => /^--text-\d?xl$/.test(name);
const swatchClass = "flex flex-col gap-1 text-xs";
const chipClass = "block h-12 rounded-lg inset-ring inset-ring-gray-700";
const valueClass = "text-gray-300 wrap-anywhere";
// Browsers indent list items for their bullet; the grid has none.
const gridClass =
  "grid list-none grid-cols-2 gap-4 p-0 *:ms-0 md:grid-cols-4";

function fakePost(
  title: string,
  description: string,
  published: string,
  tags: string[] = []
): Post {
  return {
    data: {
      pluginProps: { permalink: "/style-guide/" },
      rawNoteProps: {
        title,
        description,
        tags,
        published,
        last_updated: published,
      },
    },
  } as unknown as Post;
}
const headerPost = fakePost("Note header", "", "2026-09-26T12:00", [
  "style-guide",
  "tokens",
]);
const recent = [
  fakePost("A recent post", "Its description.", "2026-09-20T09:00"),
  fakePost("A post without a description", "", "2026-09-01T09:00"),
];
---

<BaseLayout title="Style guide" type="website">
  <SiteNavigation slot="navigation" />
  <h1>Style guide</h1>
  <p>
    Tokens from <code>src/styles/tokens.css</code>. Each one is a CSS custom
    property and, in Tailwind, a utility.
  </p>

  <h2>Colors</h2>
  <ul class={gridClass}>
    {
      colors.map(token => (
        <li class={swatchClass}>
          <span class={chipClass} style={`background: var(${token.name})`} />
          <code>{token.name}</code>
          <span class={valueClass}>{token.value}</span>
          <span style={`color: var(${token.name})`}>Aa text</span>
        </li>
      ))
    }
  </ul>

  <h2>Fonts</h2>
  {
    fonts.map(token => (
      <p style={`font-family: var(${token.name})`}>
        <code>{token.name}</code> The quick brown fox jumps over the lazy dog
        0123456789
      </p>
    ))
  }

  <h2>Type scale</h2>
  {
    sizes.map(token => (
      <p
        class:list={["my-2", heading(token.name) ? "font-serif font-normal" : "font-sans"]}
        style={`font-size: var(${token.name}); line-height: var(${token.name}--line-height, normal); letter-spacing: var(${token.name}--letter-spacing, normal)`}
      >
        {token.name.replace("--text-", "")} · {token.value}
      </p>
    ))
  }

  <h2>Leading</h2>
  {
    leading.map(token => (
      <p class="my-4" style={`line-height: var(${token.name})`}>
        <code>{token.name}</code> · {token.value}. Two lines of interface text
        show how far apart the lines of a paragraph sit at this leading.
      </p>
    ))
  }

  <h2>Radii</h2>
  <ul class={gridClass}>
    {
      radii.map(token => (
        <li class={swatchClass}>
          <span
            class={`${chipClass} bg-gray-800`}
            style={`border-radius: var(${token.name})`}
          />
          <code>{token.name}</code>
          <span class={valueClass}>{token.value}</span>
        </li>
      ))
    }
  </ul>

  <h2>Other tokens</h2>
  <table>
    <tbody>
      {
        other.map(token => (
          <tr>
            <td>
              <code>{token.name}</code>
            </td>
            <td>{token.value}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <h2>Components</h2>
  <NoteHeader post={headerPost} />
  <RecentPosts posts={recent} />
  <PostFooter />

  <h2>Markdown sample</h2>
  <Sample />
</BaseLayout>

