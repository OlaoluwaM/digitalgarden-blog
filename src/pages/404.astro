---
// T4 (phase 1): standalone 404 page, not using BaseLayout
import "../styles/global.css";
import { site } from "../lib/site.ts";
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nothing here</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={site.name}
      href={new URL("/feed.xml", site.url).href}
    />
  </head>
  <body>
    <main class="content centered">
      <h1 class="font-serif font-normal text-5xl mt-7 mb-7">
        There is nothing here
      </h1>
      <p>If you got here from a link, this note is probably not made public</p>
      <a class="link-underline text-gray-200 hover:text-gray-100" href="/"
        >Go back home</a
      >
    </main>
  </body>
</html>
