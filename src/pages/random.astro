---
// /random/: sends the visitor to a random published note. Standalone, like
// the 404 page: it shows nothing but a fallback without JavaScript, so it
// needs neither the navigation nor the page scripts. Home is not a note to
// land on at random, so the list holds articles only, and hidden ones only
// open from a direct link.
import "../styles/global.css";
import {
  getListedPosts,
  getPublishedArticles,
  getPublishedPosts,
} from "../content/posts";
import { site } from "../lib/site.ts";
import SiteHead from "../components/SiteHead.astro";

const urls = getPublishedArticles(getListedPosts(await getPublishedPosts()))
  .map(post => post.data.pluginProps.permalink)
  .sort();
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <SiteHead title="Random Page">
      <script
        type="application/json"
        id="random-notes"
        set:html={JSON.stringify(urls)}
      />
      <!-- Inline, so the redirect starts before the rest of the page loads.
           `replace` leaves this page out of the history, so Back returns to
           where the visitor came from instead of redirecting again. -->
      <script is:inline>
        const urls = JSON.parse(
          document.getElementById("random-notes").textContent
        );
        location.replace(
          urls.length ? urls[Math.floor(Math.random() * urls.length)] : "/"
        );
      </script>
    </SiteHead>
  </head>
  <body>
    <main class="content">
      <noscript>
        <p>
          JavaScript is required for random redirect.{" "}
          <a class="link-underline text-gray-200 hover:text-gray-100" href="/"
            >Go home</a
          >.
        </p>
      </noscript>
    </main>
  </body>
</html>
