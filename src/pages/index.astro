---
import { render } from "astro:content";
import { getHomePost, getPublishedPosts } from "../content/posts";

const posts = await getPublishedPosts();
// There should always be a garden entry, so we can safely use the non-null assertion operator here. If one doesn't exist, we want to throw an error and fail the build.
const home = getHomePost(posts);
const { Content: HomePageContent } = await render(home);
---

<HomePageContent />

<script>
  import { initializeCopyButtons } from "../scripts/copyCode";

  initializeCopyButtons();
</script>
