---
// T2 (phase 1): note title, tags, and timestamps.
import type { Post } from "../content/posts.ts";
import Icon from "./Icon.astro";
import { formatNoteDate } from "../lib/dates.ts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, tags, published, last_updated } = post.data.rawNoteProps;

function tagHref(tag: string): string {
  return `/?q=${encodeURIComponent(`#${tag}`)}`;
}
---

<header>
  <h1 class="font-serif font-normal text-h1 tracking-normal mt-7 mb-11">
    {title}
  </h1>
  <div class="header-meta">
    <div class="header-tags flex flex-wrap gap-2">
      {
        tags.map((tag: string) => (
          <a
            class="tag inline-flex h-8 items-center justify-center whitespace-nowrap rounded-tag border-0 border-solid border-link/20 bg-link/10 px-2 py-1 text-tag font-medium text-link no-underline shadow-input transition-colors hover:border-link/30 hover:bg-link/15 hover:text-link-hover motion-reduce:transition-none"
            href={tagHref(tag)}
          >
            #{tag}
          </a>
        ))
      }
    </div>
    <div class="timestamps mt-5 flex gap-2.5 text-meta text-muted tabular-nums">
      <div
        title="Created at"
        aria-label="Created at"
        class="flex items-center gap-[3px]"
      >
        <Icon name="calendar-plus" class="size-4" />{" "}
        <time class="human-date" datetime={published}>
          {formatNoteDate(published)}
        </time>
      </div>
      <div
        title="Updated at"
        aria-label="Updated at"
        class="flex items-center gap-[3px]"
      >
        <Icon name="calendar-clock" class="size-4" />{" "}
        <time class="human-date" datetime={last_updated}>
          {formatNoteDate(last_updated)}
        </time>
      </div>
    </div>
  </div>
</header>
