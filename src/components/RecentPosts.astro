---
// T4 (phase 1): the home page Recent Posts section.
import type { Post } from "../content/posts.ts";
import { formatNoteDate } from "../lib/dates.ts";
import { metaDescription } from "../lib/metadata.ts";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="recent-notes mt-8">
      <h2 class="font-serif font-normal text-h2 mt-[1.75em] mb-7">
        Recent Posts
      </h2>
      <ul class="my-7 list-none p-0">
        {posts.map(post => (
          <li class="relative mb-5 py-[0.175em] last:mb-0">
            <a
              href={post.data.pluginProps.permalink}
              class="internal-link text-link no-underline hover:text-link-hover hover:underline"
            >
              {post.data.rawNoteProps.title}
            </a>
            {metaDescription(post.data.rawNoteProps.description) && (
              <p class="m-0 text-teaser text-faint">
                {metaDescription(post.data.rawNoteProps.description)}
              </p>
            )}
            <time
              class="human-date recent-note-date mt-[0.4rem] block text-xs text-faint not-italic"
              datetime={post.data.rawNoteProps.published}
            >
              {formatNoteDate(post.data.rawNoteProps.published)}
            </time>
          </li>
        ))}
      </ul>
    </section>
  )
}
