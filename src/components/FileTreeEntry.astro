---
// T3: one row of the sidebar/mobile file tree — a collapsible folder or a
// single note link — recursing into itself for a folder's children. Mirrors
// Eleventy's `menuItem` macro (`src/site/_includes/components/filetree.njk`),
// minus the Alpine.js state:
//   - `menuItem`'s per-child wrapper (`<div class="{{'filelist' if step>0}}">`)
//     becomes this component's own wrapper `<div>`, at every depth.
//   - the folder's `x-data="{isOpen: $persist(false).as(path)}"` /
//     `@click.stop="isOpen=!isOpen"` becomes a native
//     `<details class="folder inner-folder">` / `<summary>`, which opens and
//     closes without JS (closed by default, matching the live `false`
//     default before a visitor has toggled it).
//   - the persisted state's key (`path`) becomes `data-folder-path`, which
//     scripts/folderState.ts reads.
//   - the two `<i data-lucide>` chevrons, each shown/hidden by `x-show`,
//     are both still rendered; `styles/components/navigation.css` swaps
//     which one is visible based on the native `[open]` attribute instead of
//     Alpine state.
import type { FileTreeNode } from "../content/file-tree.ts";
import Icon from "./Icon.astro";
// Astro requires a recursive component to explicitly import itself.
import FileTreeEntry from "./FileTreeEntry.astro";

interface Props {
  node: FileTreeNode;
  /** 0 for a root-level entry; Eleventy's `step` in the ported macro. */
  depth: number;
  activePathname: string;
  /** The enclosing folder's path; absent at the root. */
  parentPath?: string;
}

const { node, depth, activePathname, parentPath } = Astro.props;
// Live's `menuItem` path: the root folder's name, then "/" and each nested
// folder's name. Live saved a folder's open state under it.
const path =
  node.type === "folder"
    ? parentPath === undefined
      ? node.name
      : `${parentPath}/${node.name}`
    : parentPath;
const nested = depth > 0;
const active = node.type === "file" && node.href === activePathname;
const chevronClass = "mr-0.5 size-3 opacity-50";
// Eleventy: `class="{{'filelist' if step>0}}"` — no class at all at the
// root, where step is 0. Nested rows draw the depth line.
const wrapperClass = nested
  ? "filelist ml-2 border-l border-l-gray-100/40"
  : undefined;
// Note links use `hover:underline!` because their inline
// `text-decoration:none` would otherwise win over a utility.
---

<div class={wrapperClass}>
  {node.type === "folder" ? (
    <details class="folder inner-folder ml-3 py-1" data-folder-path={path}>
      <summary class="foldername-wrapper align-icon my-1 ml-0.5 inline-flex cursor-pointer list-none items-center justify-evenly text-sm/relaxed">
        <Icon
          name="chevron-down"
          class={`folder-chevron-open ${chevronClass}`}
        />
        <Icon
          name="chevron-right"
          class={`folder-chevron-closed ${chevronClass}`}
        />
        <span class="foldername">{node.name}</span>
      </summary>
      {node.children.map(child => (
        <FileTreeEntry
          node={child}
          depth={depth + 1}
          activePathname={activePathname}
          parentPath={path}
        />
      ))}
    </details>
  ) : (
    <div
      class:list={[
        "notelink",
        active && "active-note",
        "relative flex items-center py-1 pr-2 pl-3 text-sm/relaxed hover:bg-white/5",
        // Nested notes carry a 2px left rule (colored when active) over
        // the folder's depth line; root notes have none and are indented
        // past the folder chevrons.
        nested
          ? [
              "-ml-px border-l-2",
              active ? "border-l-gray-200" : "border-l-transparent",
            ]
          : "ml-5.5 border-l-0",
      ]}
    >
      <a
        data-note-icon=""
        style="text-decoration:none"
        class:list={[
          "filename hover:underline!",
          active ? "text-gray-50" : "text-gray-200 hover:text-gray-100",
        ]}
        href={node.href}
      >
        {node.title}{" "}
      </a>
    </div>
  )}
</div>
